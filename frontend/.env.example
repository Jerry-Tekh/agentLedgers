# Required in production. The app has no runtime UI for either of these --
# both are baked into the build by Vite, so they must be set in your hosting
# provider's environment variable settings (Vercel, Netlify, etc.) before
# running `npm run build`.

# The deployed AgentLedger contract address.
# The all-zero value below is a non-functional placeholder: it passes the
# 0x + 40-hex format check but points at no contract, so the app will render
# its configuration-error screen until you replace it with a real address.
# Use the address from your own `genlayer deploy` (recorded in
# deploy/deployments.json for the canonical Bradbury deployment).
VITE_AGENTLEDGER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# The genlayer-js chain export name the contract above is deployed to.
# One of: localnet | studionet | testnetAsimov | testnetBradbury
# (run `node -e "console.log(Object.keys(require('genlayer-js/chains')))"`
# against your installed genlayer-js version to confirm the current set).
VITE_AGENTLEDGER_CHAIN=testnetBradbury
